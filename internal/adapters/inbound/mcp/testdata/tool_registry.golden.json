            "number"
          ]
        },
        "sellerId": {
          "type": "string"
        },
        "shipmentsReceived": {
          "type": "integer"
        },
        "window": {
          "type": "string"
        },
        "windowEnd": {
          "type": "string"
        },
        "windowStart": {
          "type": "string"
