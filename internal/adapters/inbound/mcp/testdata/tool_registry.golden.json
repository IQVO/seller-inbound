  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Answer a seller's rolling-window compliance scorecard from the facts this service recorded (ADR 0005): shipments received in the window, cartons reported and how many were RECEIVED, receiptAccuracyRate (omitted when nothing was reported), discrepancies by kind, discrepancyRatePerShipment (omitted when no shipment closed), compliance violations and the derived complianceTier (GOOD, WATCH or AT_RISK), which is informational only. window is 7d or 30d and defaults to 30d. Read-only; an unknown seller fails with not-found, a bad window with invalid-window.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "sellerId": {
          "description": "the seller id whose compliance scorecard is answered, e.g. seller-77",
          "type": "string"
        },
        "window": {
          "description": "optional rolling window that ends now: 7d or 30d; omitted means 30d",
          "type": "string"
        }
      },
      "required": [
        "sellerId"
      ],
      "type": "object"
    },
    "name": "get_seller_scorecard",
